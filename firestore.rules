rules_version = '2';service cloud.firestore {match /databases/{database}/documents {match /users/{userId}/{kind}/{itemId} {allow read: if request.auth != null && request.auth.uid == userId && kind in ['notes','collections'];allow create, update: if request.auth != null && request.auth.uid == userId && kind in ['notes','collections'] && request.resource.data.id == itemId && request.resource.data.keys().hasOnly(kind == 'notes' ? ['id','title','content','collectionId','tags','favorite','archived','deletedAt','createdAt','updatedAt'] : ['id','name','updatedAt']) && (kind == 'collections' ? request.resource.data.name is string && request.resource.data.name.size() <= 120 : request.resource.data.title is string && request.resource.data.title.size() <= 180 && request.resource.data.content is string && request.resource.data.content.size() <= 200000 && request.resource.data.tags is list && request.resource.data.tags.size() <= 20);allow delete: if false;}}}